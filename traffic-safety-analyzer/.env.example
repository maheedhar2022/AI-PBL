# ── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# ── Camera ───────────────────────────────────────────────────────────────────
CAMERA_SOURCE=0              # 0 = default webcam; path to video file for testing
CAMERA_FPS_TARGET=10         # frames per second to capture
INFERENCE_WIDTH=640
INFERENCE_HEIGHT=640

# ── AI Model ─────────────────────────────────────────────────────────────────
MODEL_NAME=yolov8n.pt        # any ultralytics-compatible .pt weight file
CONFIDENCE_THRESHOLD=0.40
IOU_THRESHOLD=0.45
MAX_DETECTIONS=50

# ── Violation rules ───────────────────────────────────────────────────────────
HELMET_FRAMES_REQUIRED=5        # consecutive frames before raising alert
TRIPLE_FRAMES_REQUIRED=5
MIN_RIDER_ASSOCIATION_IOU=0.10
DEDUP_SECONDS=30                # suppress duplicate incident within this window

# ── Storage ───────────────────────────────────────────────────────────────────
EVIDENCE_DIR=./evidence
DATABASE_URL=sqlite+aiosqlite:///./traffic_safety.db

# ── Evaluation ────────────────────────────────────────────────────────────────
DATASET_DIR=./research/datasets
RESULTS_DIR=./research/reports

